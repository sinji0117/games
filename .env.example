# API 서버
API_BIND=0.0.0.0:8080
RUST_LOG=info,game_api=debug
CORS_ORIGINS=http://localhost:5173

# 영구 저장소 (확정 결과 원본 + Redis 폴백). 비우면 결과를 메모리에만 보관
DATABASE_URL=mysql://games:games@127.0.0.1:3306/games
# 진행 중 방 상태 · 레이트 리밋. 비우거나 연결 실패 시 MariaDB(없으면 메모리)로 폴백
REDIS_URL=redis://127.0.0.1:6379

# 방 수명(초), 기본 24시간
SESSION_TTL_SECS=86400
# 리버스 프록시 뒤에서만 true: X-Real-IP (없으면 X-Forwarded-For 첫 주소)를 클라이언트 IP 로 사용
# 비우면 127.0.0.1 에만 열렸을 때 자동으로 true
TRUST_PROXY=false
# Redis 키 · Pub/Sub 채널 접두사 (Rpanel Redis 계정 키 패턴 mg:* 와 맞춤)
REDIS_KEY_PREFIX=mg:
