# Rpanel 앱 → 환경변수 탭에 넣을 값
#
# PORT · DATABASE_URL · REDIS_URL 은 Rpanel 이 자동으로 넣어 주므로 여기에 쓰지 않습니다.
# (데이터베이스 탭에서 MariaDB 를 만들고 Redis 를 배정하면 됩니다)
# 비밀번호 · 토큰 같은 비밀값은 이 파일이 아니라 Rpanel 화면에만 넣습니다.

# 로그 수준
RUST_LOG=info,game_api=info

# Redis 키 · Pub/Sub 채널 접두사 (기본 mg:). 한 Redis 를 다른 앱과 같이 쓰면 앱마다 다르게
# Redis 계정을 따로 만든다면 키 패턴을 이 접두사 + * (예: mg:*) 로
# REDIS_KEY_PREFIX=mg:

# 게임 방 수명(초), 기본 24시간
# SESSION_TTL_SECS=86400

# 접속 IP (레이트 리밋) — 127.0.0.1 에만 열려 있으면 Rpanel Nginx 의 X-Real-IP 를 자동으로 씀.
# 강제로 끄거나 켤 때만
# TRUST_PROXY=true

# 로그인 쿠키 Secure — 비우면 https 요청에만 자동으로 붙음
# COOKIE_SECURE=true

# 다른 도메인의 화면에서 API 를 부를 때만 (같은 도메인이면 필요 없음)
# CORS_ORIGINS=https://other.example.com
